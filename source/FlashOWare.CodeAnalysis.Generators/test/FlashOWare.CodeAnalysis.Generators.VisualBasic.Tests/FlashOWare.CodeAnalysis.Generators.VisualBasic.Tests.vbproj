<Project Sdk="MSTest.Sdk/4.5.1">

  <PropertyGroup>
    <TargetFramework Condition="!$([System.OperatingSystem]::IsWindows())">net10.0</TargetFramework>
    <TargetFrameworks Condition="$([System.OperatingSystem]::IsWindows())">net10.0;net472</TargetFrameworks>
    <RootNamespace>FlashOWare.CodeAnalysis.Generators.VisualBasic.Tests</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../roslyn/FlashOWare.CodeAnalysis.Generators.VisualBasic.Roslyn/FlashOWare.CodeAnalysis.Generators.VisualBasic.Roslyn.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
