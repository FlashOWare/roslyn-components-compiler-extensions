<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FlashOWare.CodeAnalysis.Generators.VisualBasic.Demo.ConsoleApp</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FlashOWare.CodeAnalysis.Generators.VisualBasic.Demo.RoslynComponent/FlashOWare.CodeAnalysis.Generators.VisualBasic.Demo.RoslynComponent.vbproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
